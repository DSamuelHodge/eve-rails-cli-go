import { defineTool } from "eve/tools";
import { {{ .tool.ApprovalHelper }} } from "eve/tools/approval";
import { z } from "zod";

export default defineTool({
  description: {{ .tool.DescriptionLiteral }},
  approval: {{ .tool.ApprovalLiteral }},
  inputSchema: z.object({}),
  async execute() {
    return {
      status: "not_implemented",
      tool: {{ .tool.NameLiteral }},
      contract: {
        sideEffects: {{ .tool.SideEffectsLiteral }},
        requiredApprovals: {{ .tool.RequiredApprovalsLiteral }},
        requiredEnv: {{ .tool.RequiredEnvLiteral }},
        requiredConnectors: {{ .tool.RequiredConnectorsLiteral }},
        sandboxCompatibility: {{ .tool.SandboxCompatibilityLiteral }},
        failureModes: {{ .tool.FailureModesLiteral }},
      },
    };
  },
});
